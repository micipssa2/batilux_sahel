# Copier ce fichier en .env et remplir les vraies valeurs.
# Ne jamais commiter le .env réel.

ENVIRONMENT=development
DEBUG=true

# Adapter user/mot de passe/nom de DB selon docker-compose.yml ou votre install locale.
DATABASE_URL=postgresql+asyncpg://batilux:batilux@localhost:5432/batilux_sahel
DATABASE_URL_SYNC=postgresql+psycopg2://batilux:batilux@localhost:5432/batilux_sahel

# Origines autorisées pour le frontend (séparées par une virgule au format JSON)
CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Cloudinary (stockage des images familles/produits) ---
# Récupérables dans le dashboard Cloudinary : cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- JWT ---
# ⚠️ OBLIGATOIRE en prod : générer une vraie clé avant tout déploiement :
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-insecure-secret-change-me-before-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Anti brute-force ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- 2FA ---
TOTP_ISSUER_NAME=Batilux Sahel
