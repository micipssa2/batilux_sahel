# Copy this file to .env and fill in the values from your EmailJS dashboard
# (https://dashboard.emailjs.com/admin). Never commit the real .env file.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# URL de l'API backend (Phase 4). Par défaut : backend local en dev.
VITE_API_URL=http://localhost:8000/api
